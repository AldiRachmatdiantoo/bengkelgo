# Base URL of the API as seen by the browser.
# Dev: keep "/api/v1" (Vite proxies it). Production (Vercel): full URL, e.g. https://api.bengkelapp.com/api/v1
VITE_API_URL=/api/v1
# Dev-only: where the Vite proxy forwards /api (NGINX = 8080, `npm run dev` backend = 4000)
VITE_PROXY_TARGET=http://localhost:8080

# Google sign-in (PKCE). Leave empty to hide the "Masuk dengan Google" button.
# Must be the same OAuth client as GOOGLE_CLIENT_ID in backend/.env.
VITE_GOOGLE_CLIENT_ID=
