# Copy to .env (never commit .env) and fill in real values.

# Database password (letters and digits only: it goes inside the DATABASE_URL)
POSTGRES_PASSWORD=change_me_db_password

# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters

# Served over plain http (http://<IP_PUBLIC_VM>), so the cookie must not be Secure or login fails
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Address people open in the browser: http://localhost locally, http://<IP_PUBLIC_VM> on the VM
CORS_ORIGINS=http://localhost
APP_URL=http://localhost

# Booking reminders (emails are only logged until SMTP_* or GMAIL_* are set)
ENABLE_CRON=true
CRON_TIMEZONE=Asia/Jakarta
