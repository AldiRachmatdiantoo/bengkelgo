# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173
# Number of reverse-proxy hops to trust (NGINX = 1)
TRUST_PROXY=1

# ---- Database (Supabase / PostgreSQL + PostGIS) ----
# Supabase: Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgres://bengkel:bengkel@localhost:5432/bengkel
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---- Redis (rate limiter). Leave empty to use in-memory store (dev only) ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
# "lax" for same-site deployments, "none" when frontend & API are on different sites (requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax

# ---- Google OAuth 2.0 (Authorization Code + PKCE) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ---- Business rules ----
# Booking abuse guards: max unfinished bookings per customer, max booking attempts per customer per hour
BOOKING_MAX_ACTIVE=3
BOOKING_MAX_PER_HOUR=5
EMERGENCY_RADIUS_METERS=5000
EMERGENCY_RESPONSE_TIMEOUT_SECONDS=120
EMERGENCY_MAX_ROUTING_ATTEMPTS=5

# ---- Uploads ----
# Uploaded images: local (UPLOAD_DIR on disk) or supabase (private Storage bucket, for hosts without a disk)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
SUPABASE_URL=
# Server-only secret; never put it in the frontend
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads
MAX_UPLOAD_BYTES=2097152
# iPhone HEIC photos: accepted up to this size and converted to JPEG on the server (needs ~30 MB RAM per
# megapixel, one at a time). HEIC_MAX_MEGAPIXELS=0 turns server conversion off (the web app converts in the browser).
MAX_HEIC_UPLOAD_BYTES=10485760
HEIC_MAX_MEGAPIXELS=13

# ---- Email (Nodemailer SMTP). Leave SMTP_HOST empty to log emails instead of sending ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Gmail API instead of SMTP (for hosts that block SMTP ports, e.g. Render Free). See docs/deploy-gratis.md step 3.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Web app address used for links in emails (production: the Vercel/domain URL)
APP_URL=http://localhost:5173
MAIL_FROM="Bengkel App <no-reply@bengkelapp.com>"

# ---- Cron ----
ENABLE_CRON=true
REMINDER_CRON=0 8-20 * * *
CRON_TIMEZONE=Asia/Jakarta

# ---- Seed admin (used by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@bengkelapp.com
SEED_ADMIN_PASSWORD=ChangeMe!Admin123

# Run SQL migrations automatically when the API boots (advisory-locked, safe with replicas)
RUN_MIGRATIONS_ON_BOOT=false
